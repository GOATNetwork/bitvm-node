[header_chain]
enable = false 
init_input = false 
esplora_url = "http://127.0.0.1:13002"
start = 116000
#start = 1000
block_headers = "../circuits/data/header-chain/block_headers.bin"
force_fetch = true 
# Reuse local headers only when init_input = true and start = 0; fetch missing headers.
prefer_local_headers_on_init = false

batch_size = 10 
input_proof = "../circuits/data/header-chain/0-116000.bin"
output_proof = "../circuits/data/header-chain/116000-10.bin"
bitcoin_network = "regtest"

