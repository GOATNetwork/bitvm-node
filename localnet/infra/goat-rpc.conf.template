# GOAT_BACKEND=testnet3 (infra/docker-compose.yml, service goat-rpc): the local plain-HTTP GOAT
# endpoint, forwarded to GOAT_UPSTREAM_RPC. The nginx image fills in the ${...} variables at start.
server {
    listen 8545;
    client_max_body_size 16m;

    location / {
        proxy_pass ${GOAT_UPSTREAM_RPC};
        proxy_http_version 1.1;
        proxy_set_header Host ${GOAT_UPSTREAM_HOST};
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name ${GOAT_UPSTREAM_HOST};
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }
}
