# ============================================================================
# localnet/scripts/localnet.env -- single source of shared, tunable config for
# the in-repo BitVM2 localnet (bitcoin regtest + anvil + local graph-node, five
# mock-gc nodes, everything on 127.0.0.1).
#
# Sourced (bash) by every script under localnet/scripts, localnet/e2e and the
# contracts / subgraph deployers. Two roots:
#   LOCALNET_ROOT  the code: this directory's parent (scripts, e2e, compose, ...)
#   LOCALNET_DATA  the state: bin/ state/ nodes/ data/ logs/ run/ tmp/ results/
#                  default localnet/.local (git-ignored); point it at another
#                  directory to run a second, independent localnet.
# Everything else that must differ between two localnets on one host derives
# from PORT_BASE (all ports are PORT_BASE + a fixed offset) and COMPOSE_PROJECT
# (container, network and iptables chain names).
#
# Per-DATA overrides: $LOCALNET_DATA/localnet.override.env (sourced last; use it
# to adopt an existing localnet, e.g. ANVIL_CHAIN_ID=48815 for a chain created
# before the chain id changed). Runtime knobs set by the e2e suite live in
# $LOCALNET_DATA/run/tuning.env (sourced by nodes.sh at launch, see e2e/lib.sh).
#
# Contract addresses / subgraph URLs are NOT here -- they are read live from
# $LOCALNET_DATA/state/contracts.json + state/subgraph.json so a redeploy never
# leaves this file stale. Tune a value here, then
#   scripts/gen-node-envs.sh        # rebake nodes/<role>/.env (static scalars)
#   scripts/nodes.sh restart        # nodes.sh also re-exports MOCK_*/RUST_LOG
# ============================================================================

# ---- roots -------------------------------------------------------------------
export LOCALNET_ROOT="${LOCALNET_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export REPO_ROOT="${REPO_ROOT:-$(cd "$LOCALNET_ROOT/.." && pwd)}"
export LOCALNET_DATA="${LOCALNET_DATA:-$LOCALNET_ROOT/.local}"
export BIN_DIR="$LOCALNET_DATA/bin"
export STATE_DIR="$LOCALNET_DATA/state"
export NODES_DIR="$LOCALNET_DATA/nodes"
export DATA_DIR="$LOCALNET_DATA/data"
export LOGS_DIR="$LOCALNET_DATA/logs"
export RUN_DIR="$LOCALNET_DATA/run"
export TMP_DIR="$LOCALNET_DATA/tmp"
export RESULTS_DIR="$LOCALNET_DATA/results"
# Shared directory the Operator and every Verifier read/write soldering payloads.
export SOLDERING_PROOF_PAYLOAD_STORE_PATH="$STATE_DIR/soldering-store"

# ---- naming / ports ------------------------------------------------------------
export COMPOSE_PROJECT="${COMPOSE_PROJECT:-bvlocal}"   # containers are $COMPOSE_PROJECT-<service>
export PORT_BASE="${PORT_BASE:-22000}"                 # every port below is PORT_BASE + offset
export BTC_RPC_PORT=$((PORT_BASE + 443))        # bitcoind regtest RPC
export ESPLORA_PORT=$((PORT_BASE + 2))          # electrs esplora HTTP
export ANVIL_PORT=$((PORT_BASE + 545))
export IPFS_PORT=$((PORT_BASE + 501))
export GRAPH_QUERY_PORT=$((PORT_BASE + 800))
export GRAPH_ADMIN_PORT=$((PORT_BASE + 820))
export GRAPH_INDEX_PORT=$((PORT_BASE + 830))
export GRAPH_METRICS_PORT=$((PORT_BASE + 840))
# role index i in committee_0,committee_1,operator_0,verifier_0,watchtower_0
export RPC_PORT_BASE=$((PORT_BASE + 900))       # rpc     = RPC_PORT_BASE + i
export P2P_PORT_BASE=$((PORT_BASE + 910))       # p2p     = P2P_PORT_BASE + i
export METRICS_PORT_BASE=$((PORT_BASE + 920))   # metrics = METRICS_PORT_BASE + i
export PROOF_BUILDER_PORT=$((PORT_BASE + 950))
export PROXY_PORT_BASE=$((PORT_BASE + 960))     # faultproxy: + role*4 + backend (btc,goat,graph,proof)
export CHAOS_CTRL_PORT=$((PORT_BASE + 989))     # faultproxy control API
export KEYCHECK_PORT=$((PORT_BASE + 999))       # throwaway node used by tools/gen-keys.sh
export LOCALNET_UID="${LOCALNET_UID:-$(id -u)}"
export LOCALNET_GID="${LOCALNET_GID:-$(id -g)}"

# ---- infra endpoints -----------------------------------------------------------
export BTC_CHAIN_URL="http://127.0.0.1:$ESPLORA_PORT"
export GOAT_CHAIN_URL="http://127.0.0.1:$ANVIL_PORT"
export PROOF_BUILDER_ADDR="127.0.0.1:$PROOF_BUILDER_PORT"
export GOAT_PROOF_BUILD_URL="http://$PROOF_BUILDER_ADDR"   # mock-proof-builder (path-less)
export GRAPH_ADMIN="http://127.0.0.1:$GRAPH_ADMIN_PORT"
export GRAPH_IPFS="http://127.0.0.1:$IPFS_PORT"
export GRAPH_QUERY_BASE="http://127.0.0.1:$GRAPH_QUERY_PORT"
export GRAPH_INDEX="http://127.0.0.1:$GRAPH_INDEX_PORT"
export SUBGRAPH_NAME="${SUBGRAPH_NAME:-bitvm_gateway_local}"
export BITCOIN_NETWORK=regtest
export ANVIL_CHAIN_ID="${ANVIL_CHAIN_ID:-48816}"   # == Constants.CHAINID_TESTNET, so the stock contracts accept it
export ANVIL_BLOCK_TIME="${ANVIL_BLOCK_TIME:-2}"
# bitcoind CLI prefix (regtest)
export BCLI="docker exec $COMPOSE_PROJECT-bitcoind bitcoin-cli -regtest -datadir=/bitcoin -rpcuser=bvlocal -rpcpassword=bvlocal"
export BTC_RPC_WALLET=miner

# ---- images (digests of the images this localnet was last validated with) -------
export BITCOIND_IMAGE="${BITCOIND_IMAGE:-bitcoin/bitcoin:29}"
export ELECTRS_IMAGE="${ELECTRS_IMAGE:-mempool/electrs@sha256:de9dd2f5a328d5f464936dc4128d848f9b8bf72221ab3c9b8e2949df50899b74}"   # mempool/electrs:latest 2026-10
export FOUNDRY_IMAGE="${FOUNDRY_IMAGE:-ghcr.io/foundry-rs/foundry@sha256:043752653d5be351c71709091b3db97c4421c907eb40ea294195e7f532aadf46}"   # foundry 1.5.1-stable
export POSTGRES_IMAGE="${POSTGRES_IMAGE:-postgres:16}"
export IPFS_IMAGE="${IPFS_IMAGE:-ipfs/kubo:v0.17.0}"
export GRAPH_NODE_IMAGE="${GRAPH_NODE_IMAGE:-graphprotocol/graph-node@sha256:b0436347fb24f9ae45b6d3959cac97bf60b3238ad1633a875c118ff86a07a0d3}"   # graph-node:latest 2026-10
export NODE_IMAGE="${NODE_IMAGE:-node@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32}"   # node:22-alpine (graph-cli build)

# ---- tools: forge always runs in the foundry container; cast uses the host binary
# when one is installed (much faster per call) and falls back to the container.
export FORGE="$LOCALNET_ROOT/tools/forge.sh"
if [[ -z "${CAST:-}" ]]; then
  if command -v cast >/dev/null 2>&1; then CAST=$(command -v cast)
  elif [[ -x "$HOME/.foundry/bin/cast" ]]; then CAST="$HOME/.foundry/bin/cast"
  else CAST="$LOCALNET_ROOT/tools/cast.sh"; fi
fi
export CAST

# ---- p2p / protocol ------------------------------------------------------------
# Bind the p2p listener to loopback only (shared host).
export P2P_LISTEN_IP=127.0.0.1
# Protocol name distinct from every public bitvm net (two localnets on one host only ever dial
# their own bootnodes, so they never mesh either).
export PROTO_NAME="${PROTO_NAME:-bitvm_localnet}"
export MIN_REQUIRED_VERIFIER=1

# ---- shared node constants -----------------------------------------------------
export RUST_LOG="${RUST_LOG:-info}"
# Must be identical on every node AND on the mock proof builder (arbitrary 64-hex).
export GENESIS_SEQUENCER_COMMIT_TXID=662757d502c483f42a6ef7af8c0ba9cd14e28c6d31100f1161a45bf8d500b330
# The mock builder and nodes must use the same program identity and Ziren version.
# These localnet values match the mock builder defaults, not the real testnet program.
export OPERATOR_VK_HASH=0x00ba1ff974eb6e5890f238f8a11c1aeff2d5f4a68a860274bcb602c3c5c681b7
export OPERATOR_ZKM_VERSION=v2.0.0
export ZKM_IMM_WRAP_VK=1
# Small proof-wait retry windows (default 60).
export WATCHTOWER_PROOF_WAIT_SECS=60
export OPERATOR_PROOF_WAIT_SECS=60

# ---- contracts (fresh deploys only) ----------------------------------------------
# Gateway.responseWindowBlocks: upstream initialises 200 (~10 min of 3 s goat blocks); on
# 2 s anvil blocks that is ~400 s during which every peg-in stalls on WindowNotExpired.
# GatewayLocal lets the committee lower it right after the deploy.
export RESPONSE_WINDOW_BLOCKS="${RESPONSE_WINDOW_BLOCKS:-50}"

# ---- MOCK GC delays (seconds, fractional OK; read at call time) ------------------
# Heavy ops (setup/solder/verify/builder-init) are UNCAPPED. challenge/eval run
# inline on the p2p-inbox worker and are HARD-CAPPED at 60s in the binary; keep
# them to a few seconds (well under the block-mining cadence) or the honest
# operator loses the WronglyChallenged race.
export MOCK_GC_BUILDER_INIT_DELAY_SECS=2
export MOCK_GC_SETUP_DELAY_SECS=15
export MOCK_GC_SOLDER_DELAY_SECS=15
export MOCK_GC_VERIFY_DELAY_SECS=15
export MOCK_GC_CHALLENGE_DELAY_SECS=1
export MOCK_GC_EVAL_DELAY_SECS=1
# Fallback for any MOCK_GC op whose specific var is unset:
export MOCK_GC_DELAY_SECS=0
# Dispute policy: valid => happy path (Assert->Take2). The e2e suite switches the
# operator's + verifier's copy to always-invalid through run/tuning.env.
export MOCK_GC_PROOF_VERDICT=valid
export MOCK_GC_VERIFY_OPENINGS=1

# ---- MOCK proof builder delays (seconds) -------------------------------------------
export MOCK_PROOF_DELAY_SECS=0
export MOCK_PROOF_OPERATOR_DELAY_SECS=30
export MOCK_PROOF_WATCHTOWER_DELAY_SECS=30
export MOCK_PROOF_RESPONSE_LATENCY_MS=0

# ---- regtest miner -----------------------------------------------------------------
# 1 block every MINE_INTERVAL_SECS. The node assumes ~60s regtest cadence; do not
# mine much faster or CSV races (1-4 block windows) are lost.
export MINE_INTERVAL_SECS=60

# ---- funding (scripts/fund.sh) -----------------------------------------------------
# anvil dev account 0 = the ONLY GOAT faucet.
export ANVIL_FAUCET_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
export GOAT_FUND_ETH=100                 # top-up target per role
export GOAT_FUND_MIN_ETH=10              # skip GOAT funding a role already above this
# BTC amounts (BTC). committees need none. operator gets OP_BTC_UTXOS UTXOs of OP_BTC_EACH.
export OP_BTC_EACH=0.5
export OP_BTC_UTXOS=3
export VF_BTC=0.5
export WT_BTC=0.2
export USER_BTC=1.0

# ---- per-DATA override (adopting an existing localnet, local experiments) --------
if [[ -f "$LOCALNET_DATA/localnet.override.env" ]]; then
  # shellcheck disable=SC1091
  source "$LOCALNET_DATA/localnet.override.env"
fi
