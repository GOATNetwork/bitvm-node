# Proof network: zkm-fleet. Take these values from the client bundle that
# `fleetctl namespace create ... --out NAME.env` writes (NAME.env, NAME.token, NAME.ca.pem).
ZKM_PROVER="network"
#ZKM_PROVER="local"
# The fleet stage gateway, e.g. https://fleet.example:8905
ENDPOINT=
# The bundle's NAME.token. Ziren 2.0 authenticates with this token only.
FLEET_TOKEN_FILE=
ZKM_IMM_WRAP_VK=1

# TLS for an https ENDPOINT. Fleet's gateway uses a private CA by default (`fleetctl init tls`,
# certificate name "stage"): set CA_CERT_PATH to the bundle's NAME.ca.pem and DOMAIN_NAME to the
# bundle's value. Keep them commented out only when the gateway has a publicly trusted certificate
# for the ENDPOINT host; an empty value is not "unset" and makes the TLS setup fail.
#CA_CERT_PATH=
#DOMAIN_NAME=stage

ZKM_PROOF_POLL_INTERVAL=2000
#MAX_PROVER_NUM=8
#SINGLE_NODE=true

# The database connection string.
# The DB name should be same with DB in host.

# The log directory.
ESPLORA_URL=http://localhost:13002
BITCOIN_NETWORK=regtest
DATABASE_URL=sqlite:/tmp/.bitvm-node.sqlite

# GOAT contracts used for live Operator/Watchtower authorization.
GOAT_NETWORK=test
GOAT_CHAIN_URL=https://rpc.testnet3.goat.network
# Proof Builder accepts a comma-separated list; each Node still configures one Gateway address.
GOAT_GATEWAY_CONTRACT_ADDRESS=
